auto lo
iface lo inet loopback

# Bond interface with LACP (802.3ad)
auto bond0
iface bond0 inet manual
    bond-members eth1 eth2
    bond-mode 802.3ad
    bond-miimon 100
    bond-lacp-rate fast

# VLAN 78 on bond0
auto bond0.78
iface bond0.78 inet static
    address 10.78.78.104
    netmask 255.255.255.0
